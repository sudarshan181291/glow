# ---------- required
NODE_ENV=production
DATABASE_URL=postgres://mehfil:CHANGE_ME@db:5432/mehfil
# 40+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
OTP_PEPPER=CHANGE_ME_ANOTHER_RANDOM_STRING
PORT=8080

# ---------- OTP SMS (MSG91, DLT-registered template with ##OTP##)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---------- LiveKit (cloud.livekit.io project, or your own server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Razorpay (Dashboard → Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google Play Billing (service account with "View financial data" + "Manage orders")
PLAY_PACKAGE_NAME=com.mehfillive.studioroyale
# Paste the whole service-account JSON on one line
PLAY_SERVICE_ACCOUNT_JSON=
# Random string; Pub/Sub push URL = https://api.yourdomain.com/webhooks/play?token=<this>
PLAY_RTDN_TOKEN=

# ---------- Push (optional; expo.dev → Access tokens)
EXPO_ACCESS_TOKEN=

# ---------- first-run seed
STUDIO_NAME=Studio Royale
# Your own phone in +91 format; becomes the first admin
ADMIN_PHONE=+919800000000
# Staging only: create N test dancers (+919000000001 …) so you can try the app. Never set in production.
# SEED_DEMO_DANCERS=12
